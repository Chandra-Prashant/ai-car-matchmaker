# One model provider is required. Gemini has a free tier and needs no card:
# https://aistudio.google.com
GEMINI_API_KEY=

# Or Anthropic (pay-per-token):
# ANTHROPIC_API_KEY=

# Provider: gemini | anthropic | ollama | groq | openai
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
LLM_MAX_ROUNDS=8

BACKEND_PORT=8000
FRONTEND_URL=http://localhost:3000
SANDBOX_URL=http://localhost:3001
DATABASE_PATH=./data/seed/marketplace.db
