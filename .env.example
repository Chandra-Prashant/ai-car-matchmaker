# One model provider is required. Gemini has a free tier with no card:
# https://aistudio.google.com
GEMINI_API_KEY=your-key-here

# Alternatively use Anthropic (pay-per-token):
# ANTHROPIC_API_KEY=your-key-here

# Provider: gemini | anthropic | openai-compatible
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash

BACKEND_PORT=8000
FRONTEND_URL=http://localhost:3000
SANDBOX_URL=http://localhost:3001
DATABASE_PATH=./data/seed/marketplace.db
